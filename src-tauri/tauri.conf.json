{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KawaGIIF",
  "version": "0.1.1",
  "identifier": "com.kawagiif.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/KawaGIIF/media/**",
          "$LOCALDATA/KawaGIIF/loading-indicator-*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Alberto",
    "copyright": "Copyright (c) 2026 Alberto. MIT License.",
    "homepage": "https://github.com/purgemebaby/KawaGIIF",
    "category": "Utility",
    "shortDescription": "GIFs, images and videos as transparent overlays on your desktop",
    "longDescription": "KawaGIIF shows GIFs, images and videos as transparent, always-on-top, click-through overlays on the Windows desktop. Light enough to stay on all day next to games.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "Spanish"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxMjk5QUIyNTdGMUUwNUIKUldSYjRQRlhzcG9wY1hiT1NZWkQ0YnkvcFQvekZNQk5lMDZtdlhGNEZpbEM2TjNvdFUxWWE0ekcK",
      "endpoints": [
        "https://github.com/purgemebaby/KawaGIIF/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
